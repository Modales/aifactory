# Post-workout AI coach summary (see vite-plugins/aiCoachSummaryApi.ts).
# Read server-side only, by the Vite dev server's Node process — never bundled
# into client code. Copy this file to .env and set a real key to test locally;
# leave it blank to commit, and the /api/coach-summary endpoint responds 503
# instead of crashing.
# AI_COACH_PROVIDER selects which key is used: "anthropic" (default) or "openai".
AI_COACH_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
